{
  "name": "ctm-voiceai-mcp",
  "version": "0.2.0",
  "description": "MCP server that pulls CTM call transcripts and VoiceAI agent instructions so your assistant can review them and render a prompt-update HTML report, with OAuth2 login. No LLM API or key.",
  "type": "module",
  "license": "MIT",
  "author": "Jason Smith <jason.smith@ctm.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CTMJSON/ctm-voiceai-mcp.git"
  },
  "homepage": "https://github.com/CTMJSON/ctm-voiceai-mcp#readme",
  "bugs": {
    "url": "https://github.com/CTMJSON/ctm-voiceai-mcp/issues"
  },
  "keywords": [
    "mcp",
    "calltrackingmetrics",
    "voiceai",
    "call-analysis",
    "prompt-review"
  ],
  "bin": {
    "ctm-voiceai-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "prepare": "npm run build",
    "test": "npm run build && node --test test/auth.mjs && node test/sanitize.mjs && node test/smoke.mjs && node test/render.mjs",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  },
  "files": [
    "dist/",
    "engine/",
    "config/*.example",
    "config/*.json",
    "config/*.toml",
    "SKILL.md"
  ]
}
