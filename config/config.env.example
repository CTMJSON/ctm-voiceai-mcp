# Copy to ~/.config/ctm-voiceai/config.env and adjust if needed.
# Precedence: process env > this file > any file named by CTM_VOICEAI_ENV_FILE
#
# The analysis runs on your MCP client's model via MCP sampling, so there is no
# model setting and no model API key. The client must support MCP sampling.

# The OAuth app client id is shared and not a secret; the default is already set.
CTM_OAUTH_CLIENT_ID=ROB1_WEfKqNL3HHwBG5FsniXDz_E2WYw_5J_L9LDuuQ
CTM_OAUTH_SCOPE=profile activity reports

# CTM_VOICEAI_OUT_DIR=/custom/runs/dir   # defaults to ~/.local/share/ctm-voiceai/runs
# Open the finished HTML report in the default browser (default true; set 0 to disable)
CTM_VOICEAI_OPEN_REPORT=1
PYTHON_BIN=python3

# Optional legacy fallback when not using OAuth (base64 value, no "Basic " prefix)
# CTM_BASIC_AUTH=