# Copy to ~/.config/ctm-voiceai/config.env and fill in.
# Precedence: process env > this file > any file named by CTM_VOICEAI_ENV_FILE

# Optional: only needed if the MCP client does NOT support MCP sampling.
# OPENAI_API_KEY=sk-...

# LLM backend for the analysis passes: auto | sampling | openai
#   auto     - sampling when the client supports it, else OpenAI if a key is set
#   sampling - always use the host model via MCP sampling (no key)
#   openai   - always use the OpenAI Responses API (needs OPENAI_API_KEY)
CTM_VOICEAI_LLM=auto

# The OAuth app client id is not a secret; default is already set.
CTM_OAUTH_CLIENT_ID=ROB1_WEfKqNL3HHwBG5FsniXDz_E2WYw_5J_L9LDuuQ
CTM_OAUTH_SCOPE=profile activity reports
CTM_VOICEAI_MODEL=gpt-5.4-mini
# CTM_VOICEAI_OUT_DIR=/custom/runs/dir   # defaults to ~/.local/share/ctm-voiceai/runs
# Open the finished HTML report in the default browser (default true; set 0 to disable)
CTM_VOICEAI_OPEN_REPORT=1
PYTHON_BIN=python3

# Optional legacy fallback when not using OAuth (base64 value, no "Basic " prefix)
# CTM_BASIC_AUTH=